{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "app/*": ["./src/app/*"],
      "auth/*": ["./src/auth/*"],
      "components/*": ["./src/components/*"],
      "config/*": ["./src/config/*"],
      "data/*": ["./src/data/*"],
      "graphql/*": ["./src/graphql/*"],
      "utils/*": ["./src/utils/*"],
      "Others/*": ["./src/Others/*"],
      "hooks/*": ["./src/hooks/*"],
      "lib/*": ["./src/lib/*"],
      "types/*": ["./src/types/*"],
      "redux/*": ["./src/redux/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
