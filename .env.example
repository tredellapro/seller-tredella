# GraphQL API (backend-tredella). Must be running for sign-in, signup and
# password reset to work.
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:4000/graphql

# Public site origin — used for canonical URLs and the sitemap.
# NEXT_PUBLIC_SITE_URL=https://seller.tredella.com

# Shows the "Preview with demo account" button on the sign-in screen. It signs
# the visitor in as a real demo store, so leave it unset in production.
# NEXT_PUBLIC_DEMO_LOGIN=true

# Fallback the Apollo client uses when NEXT_PUBLIC_GRAPHQL_URL is unset.
# Set one or the other, not both.
# NEXT_PUBLIC_BASE_URL=http://localhost:4000/graphql
